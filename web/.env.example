# Firebase web config (Project settings → Your apps). These values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Functions region (must match functions/index.js)
VITE_FUNCTIONS_REGION=europe-west1
# true  → approvals run in the approveApplication Cloud Function (needs Blaze plan)
# false → approvals run as a client-side batch guarded by firestore.rules
VITE_USE_FUNCTIONS=false
# Point at local emulators (firebase emulators:start)
VITE_USE_EMULATORS=false
